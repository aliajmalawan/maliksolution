# ─────────────────────────────────────────────────────────────
# Malik Solution UMS — Environment Configuration Template
# Copy this file to ".env" per-environment and fill in real values.
# NEVER commit the real ".env" file — it is gitignored on purpose.
# On maliksolution.com, ".env" must hold the live cPanel DB credentials.
# ─────────────────────────────────────────────────────────────

APP_NAME="Malik UMS"
APP_ENV=local            # local | production
APP_URL=http://localhost/MalikSolution/ums
APP_TIMEZONE=Asia/Karachi

DB_HOST=localhost
DB_NAME=maliksolution
DB_USER=root
DB_PASS=
DB_PREFIX=ums_

SESSION_NAME=UMSSESSID
