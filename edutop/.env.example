# Copy this file to .env and fill in real values. Never commit .env.

APP_NAME="EduTop"
APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost/EduTop
APP_BASE_PATH=/EduTop
APP_FORCE_HTTPS=0
APP_KEY=change-this-to-a-random-64-character-string

# Session
SESSION_LIFETIME_MINUTES=120
SESSION_INACTIVITY_TIMEOUT_MINUTES=20

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edutop
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# SMTP (used for 2FA OTP emails and notifications)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@edutop.test
MAIL_FROM_NAME="EduTop"

# Initial Super Admin (used once by database/seeds/seed.php)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@edutop.test
SUPER_ADMIN_PASSWORD=ChangeMe!12345

# Login security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
